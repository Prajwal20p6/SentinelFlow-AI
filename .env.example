# ============================================================
# SentinelFlow AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# All values shown are development defaults.

# ── General ──────────────────────────────────────────────────
PROJECT_NAME=SentinelFlow AI
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── Centralized Secrets Management ────────────────────────────
# Provider options: 'env' (local .env default) or 'aws' (AWS Secrets Manager)
SECRETS_PROVIDER=env
AWS_REGION=us-east-1
AWS_SECRET_NAME=sentinelflow/production/secrets

# ── Backend (FastAPI) & Memory Optimizations ─────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Set LOW_MEMORY_MODE=true for free cloud deployment tiers (<512MB RAM limit)
LOW_MEMORY_MODE=false
DISABLE_ML_EMBEDDINGS=false
DISABLE_LOCAL_VECTOR_DB=false

# ── Frontend (Next.js) ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws
FRONTEND_PORT=3000

# ── Database (PostgreSQL) ───────────────────────────────────
# For hackathon/demo: uses SQLite fallback if PostgreSQL unavailable
DATABASE_URL=sqlite:///./sentinelflow.db
# Production: postgresql+asyncpg://sentinelflow:password@localhost:5432/sentinelflow

# ── Redis ───────────────────────────────────────────────────
# For hackathon/demo: uses in-memory fallback if Redis unavailable
REDIS_URL=redis://localhost:6379/0

# ── Qdrant (Vector Database) ────────────────────────────────
QDRANT_MODE=local
QDRANT_PATH=./data/qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Authentication & Seed Credentials ──────────────────────
SECRET_KEY=sentinelflow-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production Seed Passwords (set in environment before deployment)
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ENGINEER_PASSWORD=
DEFAULT_VIEWER_PASSWORD=
DEFAULT_JUDGE_PASSWORD=

# ── Encryption ──────────────────────────────────────────────
ENCRYPTION_KEY=sentinelflow-aes256-encryption-key!!

# ── LLM Provider ────────────────────────────────────────────
LLM_PROVIDER=simulation
# Options: openai, anthropic, simulation
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Mastra Workflow Engine ──────────────────────────────────
MASTRA_URL=http://localhost:4111
MASTRA_ENABLED=true

# Official Enkrypt AI Configuration
ENKRYPTAI_API_KEY=your-enkryptai-api-key
ENKRYPTAI_BASE_URL=https://api.enkryptai.com
ENKRYPTAI_ENABLED=true

# ── Slack Integration ───────────────────────────────────────
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=http://localhost:8000/api/v1/integrations/slack/webhook
SLACK_CHANNEL=#sentinelflow-alerts

# ── Feature Flags ───────────────────────────────────────────
FF_DEMO_MODE=true
FF_SLACK_NOTIFICATIONS=false
FF_CLOUD_REMEDIATION=true
FF_MFA_REQUIRED=false
FF_WEBSOCKET_UPDATES=true

# ── Observability ───────────────────────────────────────────
OTEL_ENABLED=true
OTEL_EXPORTER=console
OTEL_SERVICE_NAME=sentinelflow-backend
PROMETHEUS_PORT=9090

# ── Google OAuth 2.0 & OIDC ────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://sentinel-flow-ai-sigma.vercel.app/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── SMTP & Transactional Email Service ───────────────────────
EMAIL_PROVIDER_API_KEY=your-transactional-email-api-key
EMAIL_FROM=noreply@sentinelflow.ai
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@sentinelflow.ai

# ── Production Pool Settings ───────────────────────────────
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
REDIS_MAX_CONNECTIONS=50
REDIS_CONNECT_TIMEOUT=5
QDRANT_TIMEOUT=10.0

