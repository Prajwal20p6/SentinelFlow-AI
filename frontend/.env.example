# ============================================================
# SentinelFlow AI — Frontend Client Configuration
# ============================================================
# Copy this file to .env.local and configure your environment.

# URL endpoint mapping the FastAPI backend version 1 routes
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Real-time WebSocket connection endpoint
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws


# Client port listening locally
PORT=3000
